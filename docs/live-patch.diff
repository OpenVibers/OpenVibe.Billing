+        assert.strictEqual(r.status, 503, r.text); assert.strictEqual(r.json.code, 'billing_misconfigured');
+        network.grants['openvibe.billing'] = saved;
+        require('../server/net/network-principal').invalidate('openvibe.billing');
+    });
