# ═══════════════════════════════════════════════════════════════
# billing.openvibe.network — Environment Configuration
# Copy to .env for development. In production this lives at /etc/openvibe/billing.env (0600).
# ═══════════════════════════════════════════════════════════════

# Server: the service API (other services call http://127.0.0.1:4600/api/v1 — never through nginx),
# provider webhooks and the staff console (https://billing.openvibe.network/).
PORT=4600
HOST=127.0.0.1
NODE_ENV=development
BASE_URL=http://localhost:4600
TRUST_PROXY=1

# SQLite ledger (ADR-007). The systemd unit sets /var/lib/openvibe-billing/billing.db.
BILLING_DB_PATH=./data/billing.db

# ── Identity: OpenVibe.Network ──────────────────────────────
OV_NETWORK_URL=https://openvibe.network
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000
# Expected `iss` of service tokens (defaults to OV_NETWORK_URL).
#OV_NETWORK_ISSUER=https://openvibe.network
# Optional: pin the Network's RS256 public key (PEM, \n escaped) instead of fetching the JWKS.
#OV_NETWORK_PUBLIC_KEY=
# Audience Billing accepts on incoming service tokens.
BILLING_AUDIENCE=openvibe.billing
# Billing's own client credentials (client `billing` registered in the Network) — used for
# resolve-batch (identity.subject.resolve, audience openvibe.network), the events relay
# (events.event.publish, audience openvibe.events) and the staff console's SSO code exchange.
OV_OAUTH_CLIENT_ID=billing
OV_OAUTH_CLIENT_SECRET=change-me

# ── Staff console (Network SSO; see README "Staff console") ──
# The Network must list ${BASE_URL}/auth/callback (https://billing.openvibe.network/auth/callback)
# as a redirect URI of OAuth client `billing`.
# Comma-separated usr_ subject ids allowed to use the console. Each must ALSO be a Network admin
# (role admin in their Network token). Empty = nobody can sign in.
BILLING_STAFF_SUBJECTS=
# Signs the sign-in flow cookie and keys the IP hashes in staff_audit: at least 32 random characters
# (e.g. `openssl rand -hex 32`). Required in production — the console answers 503 without it.
BILLING_SESSION_SECRET=
# Absolute console session lifetime in minutes (5–720).
#BILLING_SESSION_TTL_MIN=60
# Audience a Network user token must carry.
#BILLING_SSO_AUDIENCE=openvibe.network

# ── Money rates (Live's current values are the defaults) ────
#BILLING_BITS_PER_USD=100
#BILLING_PRICE_TIERS=[{"min":25000,"usd_per_bit":0.011},{"min":10000,"usd_per_bit":0.0115},{"min":5000,"usd_per_bit":0.012},{"min":2500,"usd_per_bit":0.0124},{"min":1000,"usd_per_bit":0.013},{"min":500,"usd_per_bit":0.014},{"min":0,"usd_per_bit":0.015}]
#BILLING_MIN_PURCHASE_BITS=100
#BILLING_MAX_BITS=10000000
#BILLING_SUB_PRICE_CENTS=499
#BILLING_SUB_SHARE_PCT=70
#BILLING_SITE_ROUTE_FEE_PCT=10
#BILLING_SUB_PERIOD_DAYS=31
#BILLING_MIN_CASHOUT_BITS=500
#BILLING_ESCROW_DAYS=14
#BILLING_STRIPE_GRACE_DAYS=3

# ── Providers: each adapter is ENABLED only when its secrets are set ──
# PowerChat (the only rail carrying money in production)
POWERCHAT_WEBHOOK_SECRET=
# The site's PowerChat tips account (lower-case username). REQUIRED for PowerChat money: pcorder:/pcdon:/site
# pcsub: checkouts settle only when the tip was paid to this account (unset: they are held for review).
# Unattributed tips to it are flagged.
POWERCHAT_SITE_USERNAME=
# Credit isTest deliveries (flagged test). Development/sandbox only.
#POWERCHAT_ALLOW_TEST_FULFILLMENT=false

# Stripe (off in production)
#STRIPE_SECRET_KEY=
#STRIPE_WEBHOOK_SECRET=
# PayPal (off in production)
#PAYPAL_CLIENT_ID=
#PAYPAL_CLIENT_SECRET=
#PAYPAL_WEBHOOK_ID=
#PAYPAL_MODE=sandbox
# CCBill (off in production)
#CCBILL_WEBHOOK_SECRET=
#CCBILL_CLIENT_ACCOUNT=
#CCBILL_SUBACCOUNT=
#CCBILL_FLEXFORM_ID=
#CCBILL_SALT=
# NOWPayments (off in production)
#NOWPAYMENTS_API_KEY=
#NOWPAYMENTS_IPN_SECRET=

# ── Durable events: relay the outbox to OpenVibe.Events (off when unset) ──
#EVENTS_URL=http://127.0.0.1:4300
#EVENTS_RELAY_INTERVAL_MS=2000

# ── Background jobs: webhook retries, hourly renewal sweep, outbox relay ──
#BILLING_JOBS=on
#BILLING_SWEEP_INTERVAL_MS=3600000
#BILLING_WEBHOOK_RETRY_MS=60000
